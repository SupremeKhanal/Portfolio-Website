rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Paste your Google Auth UID(s) here, then also list them in src/config.js adminUids.
      return signedIn() && request.auth.uid in [];
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /quota/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.count is int
        && request.resource.data.count <= 10;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.count is int
        && request.resource.data.count <= 10;
    }

    match /attempts/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /attemptDetails/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /pyqSets/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /questions/{qid} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }
  }
}
