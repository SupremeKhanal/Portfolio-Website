rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Must match CBT/src/config.js adminUids. Empty = no PYQ writes.
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        "WrtJIUL3PybPTB8oeJG8NTedmgJ2"
      ];
    }

    function quotaIdOwned(docId) {
      return signedIn()
        && docId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function quotaPayloadValid(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'date', 'count'])
        && d.userId == request.auth.uid
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docId == request.auth.uid + '_' + d.date
        && d.count is int
        && d.count >= 1
        && d.count <= 10;
    }

    // ---- Users: field-whitelisted writes prevent role escalation ----
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName','email','photoURL','createdAt','updatedAt','examMode'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName','email','photoURL','updatedAt','examMode']);
      allow delete: if false;
    }

    // Doc id is "{uid}_{YYYY-MM-DD}". Count may only start at 1 and increase by 1.
    match /quota/{docId} {
      allow get: if quotaIdOwned(docId);
      allow list: if false;
      allow create: if quotaIdOwned(docId)
        && quotaPayloadValid(docId)
        && request.resource.data.count == 1;
      allow update: if quotaIdOwned(docId)
        && quotaPayloadValid(docId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.date == resource.data.date
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ---- Attempts: payload-validated, supports label updates ----
    match /attempts/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId','examMode','source','title','createdAt','score','totalMarks',
          'percent','passed','correct','wrong','skipped','guessed','timeSpent',
          'questionCount','passPercent','negativeMarkingRate','subjectStats','label'
        ])
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount <= 300;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // Allow only label edits on own attempts
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label']);
      allow delete: if false;
    }

    match /attemptDetails/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /pyqSets/{setId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
      match /questions/{qid} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // ---- Deny-all fallback: any path not matched above is blocked ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
